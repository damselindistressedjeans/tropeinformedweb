---
import Container from '@/components/Container.astro';
import Panel from '@/components/Panel.astro';
import { constants } from '@/constants';
import Page from '@/layouts/Page.astro';
import { getCollection, render } from 'astro:content';

const items = await getCollection('findings');

items.sort((a, b) => {
    return a.data.title > b.data.title ? 1 : -1;
});

const email = constants.contacts.steph.email;
---

<Page
    title="Findings"
    description="Research findings from Trope Informed"
    heading="Findings from our research"
    currentArea="findings"
>
    <p>
        Here you can find an overview of some of our research, including our
        work on <a href="#gender-bias-in-video-game-dialogue"
            >gender bias in Video Game Dialogue</a
        >, <a href="#improving-optionality-tid">improving optionality</a> to enhance
        player agency, and the <a href="#trope-informed-design"
            >method that gave us our name</a
        >. Our research is informed by the needs of game makers, and sometimes
        in direct collaboration, as with our examination of <a
            href="#key-barriers-for-women-in-gaming"
            >key barriers for women in gaming</a
        >. If you'd like to <a href="/collaborate/">collaborate with us</a>
        on future research, we’d love to <a href={`mailto:${email}`}
            >hear from you</a
        >.
    </p>
    <div class="topics" slot="sections">
        <Container>
            {
                items.map(async (item) => {
                    const {
                        id,
                        data: { title },
                    } = item;
                    const { Content } = await render(item);
                    return (
                        <Panel heading={title} color="none" id={id}>
                            <Content />
                            <div class="permalink">
                                <a href={`/findings/${id}/`}>
                                    Permalink for ‘{title}’
                                </a>
                            </div>
                        </Panel>
                    );
                })
            }
        </Container>
    </div>
</Page>

<style>
    .topics {
        background: var(--lavender);
        margin-top: 4rem;
        padding: 4rem 0;
    }

    @media (prefers-color-scheme: dark) {
        .topics {
            background: var(--lavender-dark);
        }
    }

    .permalink {
        display: flex;
        flex-direction: row-reverse;
        margin-top: 2rem;
    }

    .permalink a {
        display: block;
        font-size: var(--small);
        text-align: right;
    }

    .permalink a:before {
        content: '🔗';
    }
</style>
