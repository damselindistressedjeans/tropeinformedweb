---
import Container from '@/components/Container.astro';
import Panel from '@/components/Panel.astro';
import Page from '@/layouts/Page.astro';
import { getCollection, render } from 'astro:content';

const items = await getCollection('findings');

items.sort((a, b) => {
    return a.data.title > b.data.title ? 1 : -1;
});
---

<Page
    title="Findings"
    description="This is what we have found out okay"
    heading="Our findings"
    currentArea="findings"
>
    <p>
        Here you can read an overview of some of our key findings. Please enjoy
        perusing and learning.
    </p>
    <nav>
        <h2 class="visually-hidden">Jump to section</h2>
        <ol>
            {
                items.map(({ id, data: { title } }) => (
                    <li>
                        <a href={'#' + id}>{title}</a>
                    </li>
                ))
            }
        </ol>
    </nav>
    <div class="topics" slot="sections">
        <Container>
            {
                items.map(async (item) => {
                    const {
                        id,
                        data: { title },
                    } = item;
                    const { Content } = await render(item);
                    return (
                        <Panel heading={title} color="none" id={id}>
                            <Content />
                            <div class="permalink">
                                <a href={`/findings/${id}/`} class="permalink">
                                    Permalink for ‘{title}’
                                </a>
                            </div>
                        </Panel>
                    );
                })
            }
        </Container>
    </div>
</Page>

<style>
    .topics {
        background: var(--lavender);
        margin-top: 4rem;
        padding: 4rem 0;
    }

    @media (prefers-color-scheme: dark) {
        .topics {
            background: var(--lavender-dark);
        }
    }

    .permalink {
        text-align: right;
    }

    .permalink a {
        display: inline-block;
        font-size: var(--small);
        margin-top: 2rem;
    }

    .permalink a:before {
        content: '🔗';
    }
</style>
