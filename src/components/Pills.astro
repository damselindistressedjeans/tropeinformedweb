---
import Pill from '@/components/Pill.astro';
import type { Color } from '@/types/Color';

interface Props {
    pills: { text: string; color: Color; url?: string }[];
}

const { pills } = Astro.props;
---

{
    pills.length ? (
        <ul>
            {pills.map(({ text, color, url }) => (
                <li>
                    <Pill text={text} color={color} url={url} />
                </li>
            ))}
        </ul>
    ) : null
}

<style>
    ul {
        display: flex;
        gap: 0.25rem;
        flex-wrap: wrap;
        list-style-type: none;
        margin: 0;
        padding-left: 0;
    }

    li {
        padding-left: 0;
    }
</style>
