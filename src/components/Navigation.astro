---
import NavigationLink from '@/components/NavigationLink.astro';
import type { Area } from '@/types/Area';

interface Item {
    title: string;
    url: string;
    area: Area;
}

interface Props {
    currentArea: Area;
    items: Item[];
}

const { currentArea, items } = Astro.props;
---

<nav>
    <h2 class="visually-hidden">Main navigation</h2>
    <ul>
        {
            items.map(({ title, url, area }) => (
                <NavigationLink
                    title={title}
                    url={url}
                    current={currentArea === area}
                />
            ))
        }
    </ul>
</nav>

<style>
    ul {
        display: flex;
        gap: 1rem;
        list-style-type: none;
        margin: 0;
        padding: 0.175rem 0 0;
    }
</style>
