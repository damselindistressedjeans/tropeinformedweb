---
import type { CTA } from '@/types/CTA';

interface Props {
    cta: CTA;
}

const {
    cta: { text, url },
} = Astro.props;
---

<div>
    <a href={url}>{text}</a>
</div>

<style>
    div {
        display: flex;
        justify-content: space-between;
        flex-direction: row-reverse;
        margin-top: 4rem;
    }

    a,
    a:visited,
    a:hover,
    a:focus,
    a:active {
        display: block;
        background: white;
        border: 1px solid var(--very-faint);
        color: var(--local);
        padding: 1rem 1rem 1.5rem;
        font-weight: bold;
        border-radius: 1rem;
        box-shadow: inset 0 -0.5rem rgba(0, 0, 0, 0.125);
    }

    a:hover,
    a:focus {
        margin-top: 0.1rem;
        padding-bottom: 1.4rem;
        box-shadow: inset 0 -0.4rem rgba(0, 0, 0, 0.125);
    }

    a:active {
        margin-top: 0.3rem;
        padding-bottom: 1.2rem;
        box-shadow: inset 0 -0.2rem rgba(0, 0, 0, 0.125);
    }
</style>
