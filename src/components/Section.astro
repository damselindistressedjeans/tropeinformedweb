---
import Container from '@/components/Container.astro';
import type { Color } from '@/types/Color';
import type { CTA } from '@/types/CTA';
import CallToAction from '@/components/CallToAction.astro';

interface Props {
    heading: string;
    cta?: CTA;
    id?: string;
    color: Color | 'none';
    border?: boolean;
}

const {
    heading,
    cta = { text: 'This is the call to action', url: '.' },
    id,
    color,
    border,
} = Astro.props;
---

<section class:list={[color, { border }]} id={id}>
    <Container>
        <h2>{heading}</h2>
        <slot />
        {cta ? <CallToAction cta={cta} /> : null}
    </Container>
</section>

<style>
    section {
        background: var(--local-light);
        padding: 4rem 0;
        margin-top: 4rem;
    }

    section + section {
        margin-top: 0;
    }

    .border {
        border-top: 1px solid var(--very-faint);
    }

    .none {
        background: var(--background);
    }

    .none:last-of-type {
        margin-bottom: 0;
    }
</style>
