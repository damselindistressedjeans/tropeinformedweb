---
import Container from '@/components/Container.astro';
import type { Color } from '@/types/Color';
import type { CTA } from '@/types/CTA';
import CallToAction from '@/components/CallToAction.astro';

interface Props {
    heading: string;
    cta?: CTA;
    id?: string;
    color: Color | 'none';
}

const {
    heading,
    cta = { text: 'This is the call to action', url: '.' },
    id,
    color,
} = Astro.props;
---

<section class={color} id={id}>
    <Container>
        <h2>{heading}</h2>
        <slot />
        {cta ? <CallToAction cta={cta} /> : null}
    </Container>
</section>

<style>
    section {
        background: var(--local-light);
        padding: 4rem 0;
        margin-top: 4rem;
    }

    section + section {
        margin-top: 0;
    }

    .none:last-of-type {
        margin-bottom: 0;
    }

    div {
        display: flex;
        justify-content: space-between;
        flex-direction: row-reverse;
        margin-top: 4rem;
    }

    a,
    a:visited,
    a:hover,
    a:focus,
    a:active {
        display: block;
        background: white;
        border: 1px solid var(--very-faint);
        color: var(--local);
        padding: 1rem 1rem 1.5rem;
        font-weight: bold;
        border-radius: 1rem;
        box-shadow: inset 0 -0.5rem rgba(0,0,0,0.125);
    }

    a:hover, a:focus {
        margin-top: 0.1rem;
        padding-bottom: 1.4rem;
        box-shadow: inset 0 -0.4rem rgba(0,0,0,0.125);
    }

    a:active {
        margin-top: 0.3rem;
        padding-bottom: 1.2rem;
        box-shadow: inset 0 -0.2rem rgba(0,0,0,0.125);
    }
</style>
