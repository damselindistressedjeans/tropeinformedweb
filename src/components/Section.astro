---
import Container from '@/components/Container.astro';
import type { CTA } from '@/types/CTA';

interface Props {
    heading: string;
    cta?: CTA;
    id?: string;
    colour?: 'blue' | 'green';
}

const { heading, cta, id, colour } = Astro.props;

const colours = {
    blue: colour === 'blue',
    green: colour === 'green',
};
---

<section class:list={[colours]} id={id}>
    <Container>
        <h2>{heading}</h2>
        <slot />
        {cta && <a href={cta.url}>{cta.text}</a>}
    </Container>
</section>

<style>
    section {
        background: pink;
        padding: 4rem 0;
        margin-top: 4rem;
    }
    section:nth-of-type(2n) {
        background: green;
    }
    section + section {
        margin-top: 0;
    }

    /**
        If the last section is one of the non-coloured ones, and is
        the last item, then it doesn't need a bottom pad.
    */
</style>

