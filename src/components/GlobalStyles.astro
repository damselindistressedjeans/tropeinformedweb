<style is:global>
    :root {
        color-scheme: light dark;

        /* colours */
        --background-color: light-dark(#fbead4, #1a1208);
        --text-color: light-dark(
            rgba(0, 0, 0, 0.85),
            rgba(255, 255, 255, 0.85)
        );
        --text-color-light: light-dark(
            rgba(0, 0, 0, 0.5),
            rgba(255, 255, 255, 0.5)
        );
        --link-color: #008dac;
        --link-hover-color: #12a5c6;

        /* sizes */
        --tiny-text: 0.65rem;
        --tiny-line-height: 1rem;
        --small-text: 0.8rem;
        --small-line-height: 1rem;
        --large-text: 1.25rem;
        --huge-text: 1.75rem;
        --huge-line-height: 2rem;
        --max-width: 10rem;

        /* duration */
        --short: 100ms;
        --long: 300ms;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        position: relative;
        /* outline: 1px solid rgba(255, 0, 0, 0.1); */
    }

    .visually-hidden {
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
        width: 1px;
    }

    h1, h2, h3, h4, h5, h6 {
        font-size: inherit;
    }

    a {
        color: var(--link-color);
        text-decoration: none;
        transition: color var(--long);
    }

    a:hover,
    a:focus,
    a:active {
        color: var(--link-hover-color);
        text-decoration: underline;
        transition: color var(--short);
    }
</style>
