---
import { marked } from 'marked';

interface Props {
    date: string;
    title: string;
    description: string;
    permalink: string;
}

const { date, title, description, permalink } = Astro.props;
---

<a href={permalink} class="article-link">
    <article>
        <p class="date">{date}</p>
        <h2>{title}</h2>
        <div set:html={marked.parse(description)} />
        <!-- <p>{description}</p> -->
        <p class="cta">Read more</p>
    </article>
</a>

<style>
    a {
        color: inherit;
        text-decoration: none;
    }

    article {
        display: block;
        background: #f1f6f7;
        padding: 0.9rem;
        border: 0.1rem solid #333;
        border-radius: 0.5rem;
        corner-shape: bevel;
        box-shadow: 0.125rem 0.125rem 0 0 rgba(0, 0, 0, 0.25);
        top: 0;
        left: 0;
        transition:
            box-shadow var(--long),
            top var(--long),
            left var(--long);
    }

    .article-link * + * {
        margin-top: 0.5rem;
    }

    a:hover article,
    a:focus article,
    a:active article {
        box-shadow: 0.25rem 0.25rem 0 0 rgba(0, 0, 0, 0.125);
        top: -0.125rem;
        left: -0.125rem;
        transition:
            box-shadow var(--short),
            top var(--short),
            left var(--short);
    }

    h2 {
        font-size: var(--large-text);
    }

    .date {
        font-size: var(--small-text);
    }

    .cta {
        color: #008dac;
        /* font-weight: bold; */
        text-align: right;
    }

    .cta:after {
        content: ' 👉🏻';
    }
</style>
