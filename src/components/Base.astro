---
import { constants } from '../constants';
import type { Area } from '../types/Area';
import Footer from './Footer.astro';
import Head from './Head.astro';
import Header from './Header.astro';

interface Props {
    title?: string;
    description?: string;
    currentArea: Area;
}

const { title, description, currentArea } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
    <Head title={title} description={description} />
    <body>
        <Header currentArea={currentArea} />
        <div class="wrap">
            <main>
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    html,
    body {
        height: 100%;
        min-height: 100%;
    }

    html {
        background: var(--background-color);
        color: var(--text-color);
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            'Segoe UI',
            Roboto,
            Oxygen,
            Ubuntu,
            Cantarell,
            'Open Sans',
            'Helvetica Neue',
            sans-serif;
        font-size: clamp(1rem, 0.9rem + 0.5vw, 2rem);
        line-height: 1.5rem;
        text-wrap: pretty;
    }

    body {
        display: flex;
        flex-direction: column;
    }

    .wrap {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        margin: 0 auto;
        width: 100%;
    }

    main {
        display: block;
        flex-grow: 1;
        padding: 2rem 0;
    }
</style>
